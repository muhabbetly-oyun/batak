# =========================================================================
# /srv/oyun/.env  — sunucuda olusturulur, git'e GIRMEZ
# =========================================================================

OYUN_DOMAIN=oyun.muhabbetly.com
ACME_EMAIL=lymuhabbet@gmail.com

# --- veritabani ---
PGDATABASE=oyun
PGUSER=oyun
PGPASSWORD=DEGISTIRIN_openssl_rand_hex_24

# --- oturum imzalama (en az 32 karakter) ---
# openssl rand -hex 32
SESSION_SECRET=DEGISTIRIN_openssl_rand_hex_32

# --- jeton ekonomisi ---
SIGNUP_GIFT=5000      # kayit hediyesi
DAILY_BONUS=1000      # gunluk bonus
BANKRUPT_FLOOR=500    # bu bakiyenin altindaki oyuncuya tabana tamamlanir

# --- cerez ---
COOKIE_SECURE=1       # https ise 1

# --- panel parolasi (Caddy) ---
# docker run --rm caddy:2-alpine caddy hash-password --plaintext 'SECTIGINIZ_PAROLA'
ADMIN_HASH=DEGISTIRIN_caddy_hash_password_ciktisi
